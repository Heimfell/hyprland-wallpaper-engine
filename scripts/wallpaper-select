#!/bin/bash

CONF_FILE="$HOME/.config/hypr/wallpaper-engine.conf"
[ -f "$CONF_FILE" ] && source "$CONF_FILE"

find_steam_wp() {
  local paths=(
    "$HOME/.local/share/Steam"
    "$HOME/.steam/steam"
    "$HOME/.steam/root"
  )
  if [ -n "$STEAM_DIR" ]; then
    paths=("$STEAM_DIR" "${paths[@]}")
  fi
  for steam_dir in "${paths[@]}"; do
    local wp="$steam_dir/steamapps/workshop/content/431960"
    if [ -d "$wp" ]; then
      echo "$steam_dir"
      return
    fi
    for lib in "$steam_dir"/steamapps/libraryfolders.vdf "$steam_dir"/config/libraryfolders.vdf; do
      if [ -f "$lib" ]; then
        while IFS= read -r path; do
          local wp2="$path/steamapps/workshop/content/431960"
          if [ -d "$wp2" ]; then
            echo "$path"
            return
          fi
        done < <(grep '"path"' "$lib" 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')
      fi
    done
  done
}

STEAM_DIR="${STEAM_DIR:-$(find_steam_wp)}"
if [ -z "$STEAM_DIR" ]; then
  notify-send "Wallpaper Engine" "Steam not found. Set STEAM_DIR environment variable."
  exit 1
fi

STEAM_WP="$STEAM_DIR/steamapps/workshop/content/431960"
WE_ASSETS="$STEAM_DIR/steamapps/common/wallpaper_engine"
STATE_DIR="$HOME/.config/hypr/wallpaper-engine-states"
FPS="${FPS:-30}"
MUTE_FILE="$HOME/.config/hypr/wallpaper-engine-muted"

mkdir -p "$STATE_DIR" "$HOME/.config/systemd/user"

get_all_monitors() {
  hyprctl monitors -j 2>/dev/null | python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin)]' 2>/dev/null
}

MONITOR="${MONITOR:-}"
if [ -z "$MONITOR" ]; then
  monitors=($(get_all_monitors))
  if [ ${#monitors[@]} -eq 0 ]; then
    notify-send "Wallpaper Engine" "No monitors detected"
    exit 1
  elif [ ${#monitors[@]} -eq 1 ]; then
    MONITOR="${monitors[0]}"
  else
    selected_monitor=$(printf '%s\n' "${monitors[@]}" | rofi -dmenu -i -p "Select monitor" -theme-str 'window {width: 30%;}')
    if [ -z "$selected_monitor" ]; then
      exit 0
    fi
    MONITOR="$selected_monitor"
  fi
fi

MONITOR_SAFE=$(echo "$MONITOR" | tr '-' '_')
STATE_FILE="$STATE_DIR/${MONITOR_SAFE}"
SERVICE_FILE="$HOME/.config/systemd/user/wallpaperengine-scene-${MONITOR_SAFE}.service"

if [ ! -d "$STEAM_WP" ]; then
  notify-send "Wallpaper Engine" "No wallpapers found. Subscribe to some in Steam first."
  exit 1
fi

get_entries() {
  find "$STEAM_WP" -maxdepth 2 -name "project.json" 2>/dev/null | sort | while read -r f; do
    dir=$(dirname "$f")
    title=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("title","Untitled"))' < "$f" 2>/dev/null)
    has_video=$(ls "$dir"/*.mp4 "$dir"/*.webm 2>/dev/null | head -1)
    id=$(basename "$dir")
    if [ -n "$has_video" ]; then
      echo "VIDEO|${title}|${has_video}|${id}"
    else
      echo "SCENE|${title}|${id}|${id}"
    fi
  done
}

stop_monitor() {
  local mon="$1"
  local mon_safe=$(echo "$mon" | tr '-' '_')
  systemctl --user stop "wallpaperengine-scene-${mon_safe}" 2>/dev/null
}

stop_all() {
  for mon in $(get_all_monitors); do
    stop_monitor "$mon"
  done
  pkill mpvpaper 2>/dev/null
  sleep 0.5
}

start_video() {
  local file="$1"
  local mon="$2"
  mpvpaper -f -o "no-audio --loop --panscan=1.0 --hwdec=auto --profile=fast --fps=15" "$mon" "$file" &
}

start_scene() {
  local wallpaper_id="$1"
  local mon="$2"
  local mon_safe=$(echo "$mon" | tr '-' '_')
  local svc="$HOME/.config/systemd/user/wallpaperengine-scene-${mon_safe}.service"
  local audio_flag=""
  if [ -f "$MUTE_FILE" ]; then
    audio_flag="--silent"
  fi
  cat > "$svc" << EOF
[Unit]
Description=Wallpaper Engine Scene ($wallpaper_id) on $mon
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/linux-wallpaperengine --screen-root $mon --bg $wallpaper_id --assets-dir $WE_ASSETS --no-fullscreen-pause --fps $FPS $audio_flag
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=30
StartLimitBurst=3

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user start "wallpaperengine-scene-${mon_safe}"
}

ensure_waybar() {
  sleep 1
  if pgrep -x waybar > /dev/null; then
    return
  fi
  if command -v waybar > /dev/null; then
    waybar > /dev/null 2>&1 &
  fi
}

update_hyprlock() {
  local img="$1"
  local lock_bg="$HOME/.cache/hyde/wallpapers/hyprlock.png"
  if command -v ffmpeg > /dev/null && [ -f "$img" ]; then
    mkdir -p "$(dirname "$lock_bg")"
    [ -L "$lock_bg" ] && rm -f "$lock_bg"
    ffmpeg -y -i "$img" -vframes 1 -update 1 -q:v 2 "$lock_bg" > /dev/null 2>&1
  fi
}

apply_theme() {
  local wp_id="$1"
  local theme_map="$HOME/.config/hyde/wallpaper-theme-map.conf"
  if [ -f "$theme_map" ]; then
    while IFS='|' read -r map_id map_theme; do
      if [ "$map_id" = "$wp_id" ] && [ -n "$map_theme" ]; then
        if command -v hydectl > /dev/null; then
          notify-send "HyDE Theme" "Applying theme: $map_theme..."
          hydectl theme set "$map_theme"
          notify-send "HyDE Theme" "Applied theme: $map_theme"
        fi
        break
      fi
    done < "$theme_map"
  fi
}

CACHE_FILE="$HOME/.config/hypr/wallpaper-engine-cache"
RESCAN_FLAG="$HOME/.config/hypr/.wallpaper-rescan"

do_rescan() {
  local old_ids=""
  if [ -f "$CACHE_FILE" ]; then
    old_ids=$(sort "$CACHE_FILE")
  fi

  local new_ids=""
  new_ids=$(find "$STEAM_WP" -maxdepth 2 -name "project.json" 2>/dev/null | while read -r f; do
    dir=$(dirname "$f")
    id=$(basename "$dir")
    title=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("title","Untitled"))' < "$f" 2>/dev/null)
    has_video=$(ls "$dir"/*.mp4 "$dir"/*.webm 2>/dev/null | head -1)
    if [ -n "$has_video" ]; then
      echo "VIDEO|${id}|${title}"
    else
      echo "SCENE|${id}|${title}"
    fi
  done | sort)

  echo "$new_ids" > "$CACHE_FILE"

  local new_count=0
  local removed_count=0
  local new_names=""
  local removed_names=""

  local old_id_list=$(echo "$old_ids" | awk -F'|' '{print $2}')
  local new_id_list=$(echo "$new_ids" | awk -F'|' '{print $2}')

  while IFS='|' read -r type id title; do
    [ -z "$id" ] && continue
    if ! echo "$old_id_list" | grep -qx "$id" 2>/dev/null; then
      new_count=$((new_count + 1))
      new_names="${new_names}  + ${title}\n"
    fi
  done <<< "$new_ids"

  while IFS='|' read -r type id title; do
    [ -z "$id" ] && continue
    if ! echo "$new_id_list" | grep -qx "$id" 2>/dev/null; then
      removed_count=$((removed_count + 1))
      removed_names="${removed_names}  - ${title}\n"
    fi
  done <<< "$old_ids"

  local total=$(echo "$new_ids" | grep -c '.' 2>/dev/null || echo 0)
  local msg="Total: ${total} wallpapers"

  if [ "$new_count" -gt 0 ] || [ "$removed_count" -gt 0 ]; then
    msg="${msg}\n\nChanges:"
    [ "$new_count" -gt 0 ] && msg="${msg}\n${new_count} new:\n${new_names}"
    [ "$removed_count" -gt 0 ] && msg="${msg}\n${removed_count} removed:\n${removed_names}"
  else
    local old_total=$(echo "$old_ids" | grep -c '.' 2>/dev/null || echo 0)
    if [ "$old_total" -eq 0 ]; then
      msg="${msg}\n(first scan)"
    else
      msg="${msg}\nNo changes detected"
    fi
  fi

  notify-send "Wallpaper Engine - Rescan" "$msg"
  rm -f "$RESCAN_FLAG"
}

toggle_audio() {
  if [ ! -f "$STATE_FILE" ]; then
    notify-send "Wallpaper Engine" "No wallpaper running on $MONITOR"
    return
  fi

  IFS='|' read -r type file < "$STATE_FILE"

  if [ -f "$MUTE_FILE" ]; then
    rm -f "$MUTE_FILE"
    notify-send "Wallpaper Engine" "Audio unmuted"
  else
    touch "$MUTE_FILE"
    notify-send "Wallpaper Engine" "Audio muted"
  fi

  if [ "$type" = "SCENE" ]; then
    stop_monitor "$MONITOR"
    sleep 0.5
    start_scene "$file" "$MONITOR"
  fi
}

if [ -f "$RESCAN_FLAG" ]; then
  do_rescan
fi

entries=$(get_entries)

if [ -z "$entries" ]; then
  notify-send "Wallpaper Engine" "No wallpapers found in $STEAM_WP"
  exit 1
fi

rofi_entries=$(echo "$entries" | while IFS='|' read -r type title file id; do
  echo "[${type}] ${title} (${id})"
done)

audio_label="🔇  Mute audio"
if [ -f "$MUTE_FILE" ]; then
  audio_label="🔊  Unmute audio"
fi

rofi_entries="⟳  Rescan wallpapers
${audio_label}
${rofi_entries}"

selected=$(echo "$rofi_entries" | rofi -dmenu -i -p "Wallpaper Engine ($MONITOR)" -theme-str 'window {width: 50%;}')

if [ -z "$selected" ]; then
  exit 0
fi

if [ "$selected" = "⟳  Rescan wallpapers" ]; then
  touch "$RESCAN_FLAG"
  exec "$0"
fi

if [ "$selected" = "🔇  Mute audio" ] || [ "$selected" = "🔊  Unmute audio" ]; then
  toggle_audio
  exec "$0"
fi

selected_id=$(echo "$selected" | grep -oP '\(\K[0-9]+(?=\)$)')

type=$(echo "$entries" | while IFS='|' read -r t title f id; do
  if [ "$id" = "$selected_id" ]; then echo "$t"; fi
done | head -1)

file=$(echo "$entries" | while IFS='|' read -r t title f id; do
  if [ "$id" = "$selected_id" ]; then echo "$f"; fi
done | head -1)

clean=$(echo "$selected" | sed 's/^\[VIDEO\] //;s/^\[SCENE\] //;s/ ([0-9]*)$//')

if [ -z "$file" ]; then
  notify-send "Wallpaper Engine" "Not found: $clean"
  exit 1
fi

stop_monitor "$MONITOR"

apply_theme "$selected_id"

if [ "$type" = "VIDEO" ]; then
  start_video "$file" "$MONITOR"
  echo "$type|$file" > "$STATE_FILE"
  update_hyprlock "$file"
else
  start_scene "$file" "$MONITOR"
  sleep 3
  if ! systemctl --user is-active "wallpaperengine-scene-${MONITOR_SAFE}" > /dev/null 2>&1; then
    stop_monitor "$MONITOR"
    dir=$(find "$STEAM_WP" -maxdepth 2 -type d -name "$file" 2>/dev/null | head -1)
    preview=$(ls "$dir"/preview.{jpg,png,gif} 2>/dev/null | head -1)
    if [ -n "$preview" ]; then
      mpvpaper -f -o "no-audio --loop --panscan=1.0 --hwdec=auto --profile=fast --fps=15" "$MONITOR" "$preview" &
      echo "VIDEO|$preview" > "$STATE_FILE"
      update_hyprlock "$preview"
    else
      notify-send "Wallpaper Engine" "Scene crashed. Wallpaper not supported."
      rm -f "$STATE_FILE"
      exit 1
    fi
    ensure_waybar
    notify-send "Wallpaper Engine" "$clean (scene not supported, using preview image)"
    exit 0
  fi
  echo "$type|$file" > "$STATE_FILE"
  dir=$(find "$STEAM_WP" -maxdepth 2 -type d -name "$file" 2>/dev/null | head -1)
  preview=$(ls "$dir"/preview.{jpg,png,gif} 2>/dev/null | head -1)
  if [ -n "$preview" ]; then
    update_hyprlock "$preview"
  fi
fi

ensure_waybar
notify-send "Wallpaper Engine" "$clean on $MONITOR"
